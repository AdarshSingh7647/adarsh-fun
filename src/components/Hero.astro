---
import hf from "../data/huggingface.json";

const total = hf.totalModelDownloads;
const fmt = (n: number) => n.toLocaleString("en-US");
---

<header class="hero" id="top">
  <div class="wrap">
    <span class="eyebrow">Machine learning engineer</span>
    <h1>
      I make language models <span class="grad-text">reason</span> better, then build the tests that prove it.
    </h1>
    <p class="sub">Post-training, reinforcement learning, and evals for coding agents.</p>
    <p class="by">Adarsh Singh, <strong>Tempe, Arizona</strong></p>

    <div class="ctas">
      <a class="btn btn-primary" href="#now">See what I am working on <span class="arrow">→</span></a>
      <a class="btn btn-ghost" href="#resume">Read the resume</a>
    </div>

    <div class="quick-links">
      <a class="link" href="#resume"><img class="ico" src="/icons/resume.svg" alt="" width="16" height="16" />Resume</a>
      <a class="link" href="https://www.linkedin.com/in/asing725" target="_blank" rel="noopener"><img class="ico" src="/icons/linkedin.ico" alt="" width="16" height="16" />LinkedIn</a>
      <a class="link" href="https://scholar.google.com/citations?user=LMS4nFIAAAAJ&amp;hl=en" target="_blank" rel="noopener"><img class="ico" src="/icons/googlescholar.svg" alt="" width="16" height="16" />Google Scholar</a>
      <a class="link gh" href="https://github.com/AdarshSingh7647" target="_blank" rel="noopener"><img class="ico" src="/icons/github.svg" alt="" width="16" height="16" />GitHub</a>
    </div>

    <div class="stats">
      <div class="stat">
        <div class="num"><span class="grad-text" data-hf-total>{fmt(total)}</span>+</div>
        <div class="label">model downloads on Hugging Face</div>
      </div>
      <div class="stat">
        <div class="num">3</div>
        <div class="label">papers, one at ACL 2026</div>
      </div>
      <div class="stat">
        <div class="num"><span class="grad-text">+33%</span></div>
        <div class="label">Terminal-Bench 2.0 gain, same weights</div>
      </div>
    </div>
  </div>

  <a class="scroll-cue" href="#now" aria-label="Scroll to the next section">
    Scroll <span></span>
  </a>
</header>
